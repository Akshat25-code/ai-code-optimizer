# Root gitignore for AI Code Optimizer

# --- General ---
.DS_Store
Thumbs.db
*.log
logs/
*.tmp
*.swp
.cache/
coverage/

# --- Editor/IDE ---
.vscode/
.idea/
*.code-workspace

# --- Environment files ---
.env
.env.*
!.env.example
client/.env
client/.env.*
!client/.env.example
server/.env
server/.env.*
!server/.env.example

# --- Node / Frontend ---
node_modules/
client/node_modules/
client/dist/
client/build/
client/.vite/
client/.next/
client/.turbo/
client/.parcel-cache/
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*
client/pnpm-debug.log*

# --- Python / Backend ---
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
server/.pytest_cache/
server/.mypy_cache/

# Virtual environments
env/
.venv/
venv/
server/env/
server/.venv/
server/venv/

# Build artifacts
server/*.egg-info/
*.sqlite
*.db
# OS
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.code-workspace

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Vite (client)
client/node_modules/
client/dist/
client/.env
client/.env.*

# Python caches
**/__pycache__/
**/*.py[cod]
**/*.pyo
**/*.pyd
.mypy_cache/
.pytest_cache/
.python-version

# Virtual environments
.env/
.venv/
venv/
ENV/
server/env/
client/env/
server/.venv/

# Build artifacts
build/
dist/

# Secrets
server/.env
server/.env.*
client/.env
client/.env.*

# Others
.coverage
coverage.xml
*.sqlite3

# Ensure any nested virtualenvs are ignored
**/env/

# Ignore uploaded/generated files but allow placeholder
server/uploads/
!server/uploads/.gitkeep
